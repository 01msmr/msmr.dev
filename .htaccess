# Caching und Kompression (Apache / Plesk bei netcup; nginx ignoriert die Datei)

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  # Seite immer frisch holen
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Bilder tragen ?v=… in der URL: bei Änderung Nummer erhöhen, sonst ein Jahr gültig
  <FilesMatch "\.(webp|jpg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  # Schriften ändern sich praktisch nie
  <FilesMatch "\.woff2$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
